<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="python-script-task-input-test" isExecutable="true" camunda:historyTimeToLive="1">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="script" scriptFormat="python" camunda:resultVariable="greeting">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
      <bpmn:script>f"Hello {inputValue}"</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="end">
      <bpmn:incoming>flow2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow1" sourceRef="start" targetRef="script" />
    <bpmn:sequenceFlow id="flow2" sourceRef="script" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
